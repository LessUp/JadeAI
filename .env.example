# ===== App =====
APP_NAME=JadeAI

# ===== Fork Links =====
PUBLIC_GITHUB_REPO=LessUp/JadeAI
PUBLIC_SITE_URL=https://lessup.github.io/JadeAI

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== AI =====
# Optional: enable built-in server-side AI for Docker/self-hosting
# If AI_PROVIDER is omitted, JadeAI auto-detects the first configured provider key.
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.0-flash

# ===== i18n =====
DEFAULT_LOCALE=zh
